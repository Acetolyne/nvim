return {
  "trunk-io/neovim-trunk",
  enabled = false, -- disabled: Trunk CLI SSL failure crashes plugin on startup
  lazy = false,
  config = function()
    require("trunk").setup({
      trunkPath = "trunk",
      formatOnSave = false,
      logLevel = "debug",
    })
  end,
  main = "trunk",
  dependencies = { "nvim-telescope/telescope.nvim", "nvim-lua/plenary.nvim" },
}
